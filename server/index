// ================= DONATION API =================
app.post("/api/donate", (req, res) => {

  const { user_id, name, email, amount, message, cause_id } = req.body;

  if (!user_id || !name || !email || !amount || Number(amount) <= 0) {
    return res.status(400).json({ error: "Invalid donation data" });
  }

  const sql = `
  INSERT INTO donations (user_id, name, email, cause_id, amount, message)
  VALUES (?, ?, ?, ?, ?, ?)
  `;

  db.query(
    sql,
    [user_id, name, email, cause_id || null, Number(amount), message || ""],
    (err) => {

      if (err) {
        console.error("Donation DB error:", err);
        return res.status(500).json({ error: "Database error" });
      }

      res.json({ success: true });

    }
  );

});


// ================= CONTACT API =================
app.post("/api/contact", (req, res) => {

  const { firstName, lastName, email, message } = req.body;

  if (!firstName || !lastName || !email || !message) {
    return res.status(400).json({ error: "All fields are required" });
  }

  const sql = `
    INSERT INTO contact_messages (first_name, last_name, email, message)
    VALUES (?, ?, ?, ?)
  `;

  db.query(sql, [firstName, lastName, email, message], (err) => {

    if (err) {
      console.error("Contact DB error:", err);
      return res.status(500).json({ error: "Database error" });
    }

    res.json({ success: true });

  });

});


// ================= REGISTER =================
app.post("/api/register", async (req, res) => {

  const { name, email, password } = req.body;

  const hashedPassword = await bcrypt.hash(password, 10);

  createUser(name, email, hashedPassword, (err, result) => {

    if (err) return res.status(500).json(err);

    res.json("User Registered Successfully");

  });

});


// ================= LOGIN =================
app.post("/api/login", (req, res) => {

  const { email, password } = req.body;

  const sql = "SELECT * FROM users WHERE email = ?";

  db.query(sql, [email], async (err, result) => {

    if (err) {
      console.log(err);
      return res.status(500).json({ message: "Server error" });
    }

    if (result.length === 0) {
      return res.status(400).json({ message: "User not found" });
    }

    const user = result[0];

    const match = await bcrypt.compare(password, user.password);

    if (!match) {
      return res.status(400).json({ message: "Wrong password" });
    }

res.json({
  message: "Login successful",
  token: "login_token",
  id: result[0].id,
  role: result[0].role,
  name: result[0].name,
  email: result[0].email
});
  });

});


